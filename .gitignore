# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Virtual environments
.venv/
venv/
env/

# Tooling caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Local run config (see run_config.py / .env.example) and agent scaffolding
.env
.claude/
BLOCKED.md

# uv lock metadata is checked in; this catches stray files only
.uv-cache/

# NFS lock files
.nfs*

# Benchmark run artifacts (logs + regenerable scratch output dirs)
*.log
examples/benchmark/*/out/

# OLMo SFT example: regenerable run artifacts (recreate by running the scripts).
# The committed plots (*.png) are kept on dev as reference figures; everything
# below is selection/telemetry output and stays out of version control.
examples/olmo_sft_analysis/samples.json
examples/olmo_sft_analysis/results.parquet
examples/olmo_sft_analysis/resources.json
examples/olmo_sft_analysis/mem_profile.md

# DPO spectral-filter example: same policy — commit code + *.png reference
# figures; selection/telemetry output stays out of version control. Each run
# lives under runs/<tag>/ (samples/results/sweep/resources JSON + filed SLURM
# logs); only the figures are tracked. Top-level logs/ is the SLURM landing
# zone (#SBATCH --output) before logs get filed into their run dir.
examples/dpo_spectral_filter/runs/*/*.json
examples/dpo_spectral_filter/runs/*/logs/
examples/dpo_spectral_filter/logs/
wandb/
