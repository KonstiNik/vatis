# Repo-local config for the example / benchmark scripts. Copy to `.env`
# (which is gitignored) and edit for your machine, or just export these in
# your shell instead. The installed `vatis` package does not read this file.

# HuggingFace cache directory — keeps downloaded model shards off your home
# filesystem. Leave unset to use the default (~/.cache/huggingface).
HF_HOME=/path/to/your/hf_cache

# SLURM submit settings for the benchmark jobs, used via
# examples/benchmark/submit.sh. SLURM reads these SBATCH_* variables
# automatically at submit time. Leave unset to use your cluster defaults.
SBATCH_PARTITION=your-partition
SBATCH_ACCOUNT=your-account
